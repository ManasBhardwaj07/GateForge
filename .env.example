# GateForge Environment Configuration

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/gateforge_dev

# Redis Connection
REDIS_URL=redis://localhost:6379

# Gateway & Control Plane Service Ports
PORT=4000
CONTROL_PORT=4001

# Canonical Operator Secret Token (Control API)
CONTROL_TOKEN=dev_operator_secret_token_123

# Allow internal/private upstreams (e.g., Docker service names / localhost)
ALLOW_PRIVATE_UPSTREAMS=1

# Next.js Dashboard Client Endpoints
NEXT_PUBLIC_CONTROL_API=http://localhost:4001/control
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000
